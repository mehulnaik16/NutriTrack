# Supabase (already in your project)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Groq API Keys (server-only — no VITE_ prefix) ─────────────────────────────
# Add as many as you have. The app rotates automatically on rate limits.
# Get keys at: console.groq.com
# To add more later: just add GROQ_API_KEY_4, GROQ_API_KEY_5, etc. No code changes needed.
GROQ_API_KEY_1=gsk_your_first_key_here
GROQ_API_KEY_2=gsk_your_second_key_here
GROQ_API_KEY_3=gsk_your_third_key_here
# GROQ_API_KEY_4=gsk_add_when_you_get_one
# GROQ_API_KEY_5=gsk_add_when_you_get_one

# ── Razorpay (server-only — no VITE_ prefix) ─────────────────────────────────
# Test keys only for now. Test keys process simulated transactions, so shipping
# them live shows a customer a success screen while nothing is captured.
# The key id is public (Checkout needs it in the browser) but is still read
# server-side and handed down, so there is one place to change it.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# A DIFFERENT value from the key secret. Set when you create the webhook in the
# Razorpay dashboard; it signs the raw request body of every event.
# Endpoint: https://<your-domain>/api/razorpay-webhook
# Events: subscription.activated, subscription.charged, subscription.pending,
#         subscription.halted, subscription.cancelled, subscription.completed,
#         refund.processed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Plan ids created in the Razorpay dashboard, one per tier. The discounted
# yearly plan is a separate plan rather than an offer, so the ₹150 referral gift
# is a server-side plan choice a client cannot ask for.
RAZORPAY_PLAN_MONTHLY=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_QUARTERLY=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_YEARLY=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_YEARLY_DISCOUNTED=plan_xxxxxxxxxxxx

# ── Operational alerts (optional) ────────────────────────────────────────────
# Telegram group that receives payment failures, refunds, Groq quota
# exhaustion and account deletions. Unset = alerts are a silent no-op.
# Same two variables as the ReelsMaker repo, so one bot can serve both.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
