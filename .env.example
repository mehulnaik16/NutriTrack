# Supabase (already in your project)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Razorpay (server-only — no VITE_ prefix) ─────────────────────────────────
# Test keys only for now. Test keys process simulated transactions, so shipping
# them live shows a customer a success screen while nothing is captured.
# The key id is public (Checkout needs it in the browser) but is still read
# server-side and handed down, so there is one place to change it.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# A DIFFERENT value from the key secret. Set when you create the webhook in the
# Razorpay dashboard; it signs the raw request body of every event.
# Endpoint: https://<your-domain>/api/razorpay-webhook
# Events: subscription.activated, subscription.charged, subscription.pending,
#         subscription.halted, subscription.cancelled, subscription.completed,
#         refund.processed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Plan ids created in the Razorpay dashboard, one per tier: ₹299 monthly,
# ₹599 quarterly, ₹1199 yearly — the prices in src/server/razorpay.ts. There is
# no discounted plan: the referral gift is 60 days of access granted in SQL.
RAZORPAY_PLAN_MONTHLY=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_QUARTERLY=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_YEARLY=plan_xxxxxxxxxxxx

# ── Gym partner integration (server-only — no VITE_ prefix) ──────────────────
# Gyms, their affiliate codes and their member rosters live in a SEPARATE
# Supabase project ("gym partner"), not in this one. These two values are that
# project's, pasted into THIS app, because it is the Dombelz server that calls
# into it — to verify a GYM-IRONVAULT-123 code at signup, to put a member on a
# gym's roster, and to offer each charge for commission.
#
# Get them from: Supabase -> project "gym partner" -> Project Settings -> API Keys.
# Use the service_role key, not anon: sync_gym_member(), record_gym_charge() and
# reverse_gym_charge() are granted to service_role only.
#
# NEVER give these a VITE_ prefix. That would compile the key into the browser
# bundle, and it bypasses every RLS policy in the gym database — any visitor
# would get full read/write on every gym's member list and commissions.
#
# Unset is safe: the gym code path fails closed with a named error and nothing
# else in the app is affected.
GYM_PARTNER_SUPABASE_URL=https://your-gym-project.supabase.co
GYM_PARTNER_SERVICE_ROLE_KEY=your_gym_project_service_role_key

# ── Operational alerts (optional) ────────────────────────────────────────────
# Telegram group that receives payment failures, refunds, a rejected Gemini
# key and account deletions. Unset = alerts are a silent no-op.
# Same two variables as the ReelsMaker repo, so one bot can serve both.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Gemini on Google Cloud Vertex AI (server-only — no VITE_ prefix) ───────
# Every AI feature (food search, photo, voice, weight motivation, workout
# plans) makes one call to gemini-3.5-flash-lite on Vertex AI.
# There is no AI Studio path and no fallback model.
# Option 1: a Vertex AI API key (Cloud console > APIs & Services > Credentials,
# restricted to the Vertex AI API, "AQ." prefix). Works locally and on Vercel.
# Wins if set. GEMINI_API_KEY is read as the same Vertex key if this is empty.
GOOGLE_VERTEX_API_KEY=
GEMINI_API_KEY=
# Option 2: project id + Application Default Credentials (`gcloud auth
# application-default login`). Local only until the Workload Identity (OIDC)
# client is added for Vercel.
GOOGLE_VERTEX_PROJECT=
# Option 2 only. "global" (default) routes to any region with capacity; or
# e.g. us-central1.
GOOGLE_VERTEX_LOCATION=global

# ── Telegram ops agent model (server-only) ───────────────────────────────────
# Google AI Studio key (aistudio.google.com/apikey), free tier. The ops agent
# (src/server/ops-agent.ts) runs gemini-3.5-flash-lite on it and is never put
# on Vertex. Unset = the bot replies that no model is configured.
GEMINI_AI_STUDIO_API_KEY=

# ── Anthropic / Claude (server-only — no VITE_ prefix) ───────────────────────
# Writes the Weekly AI Report (claude-haiku-5-5). Get a key at
# platform.claude.com -> API Keys. Unset = Gemini Lite writes the report
# instead; nothing else in the app is affected.
ANTHROPIC_API_KEY=
