<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Exact reminder timing on Android 12+ (API 31).

        POST_NOTIFICATIONS, RECEIVE_BOOT_COMPLETED and WAKE_LOCK are NOT listed
        here on purpose — @capacitor/local-notifications declares all three in
        its own manifest and they merge in at build time, along with a boot
        receiver that re-registers pending alarms after a restart.

        SCHEDULE_EXACT_ALARM is the one the plugin leaves to the app, because
        it is a policy decision rather than a technical one:

          - USE_EXACT_ALARM is auto-granted but Google Play restricts it to
            alarm-clock, timer and calendar apps. A nutrition tracker declaring
            it invites a rejection at review, so it is deliberately absent.

          - SCHEDULE_EXACT_ALARM needs no Play approval. On API 33+ it is off
            by default and the user grants it under Settings → Apps → Special
            app access → Alarms & reminders.

        Without the grant the plugin falls back to setAndAllowWhileIdle
        (LocalNotificationManager.java:380), so reminders still fire — Doze can
        just delay them by several minutes. That is an acceptable v1 default
        for a meal reminder. If drift turns out to bother users, the plugin
        exposes changeExactNotificationSetting() to send them to the grant
        screen; nothing here has to change for that.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
